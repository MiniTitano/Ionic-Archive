# Store text files with LF line endings and keep them LF on checkout
# (avoids the LF → CRLF warning on Windows; the site works either way)
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary
